# Local / Synology
TZ=Europe/London

# Web UI (host port -> container 8080)
WEB_HOST_PORT=8080
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Icecast (host port -> container 8000)
ICECAST_HOST_PORT=18080
ICECAST_HOSTNAME=localhost
ICECAST_PUBLIC_URL=http://127.0.0.1:18080
ICECAST_MOUNT=/test
ICECAST_SOURCE_USER=source
ICECAST_SOURCE_PASSWORD=changeme
ICECAST_RELAY_PASSWORD=changeme
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=changeme
ICECAST_LOCATION=Local Radio
ICECAST_ADMIN_EMAIL=radio@localhost

AUDIO_BITRATE=192k
ENABLE_TEST_STREAM=0
PLAYBACK_ENABLED=1
STATION_SLUG=test
PLAY_DURATION_SECONDS=full
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=2000000
DATABASE_PATH=/data/radio.db
